---
import type { Locale } from '../data/profile';
import { profile, publications } from '../data/profile';
import { localize } from '../lib/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerHero from './InnerHero.astro';
import PublicationRow from './PublicationRow.astro';
import ResearchVision from './ResearchVision.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const title = locale === 'zh' ? '研究 | 陈旺' : 'Research | Wang Chen';
const description = localize(profile.researchIntro, locale);
---
<BaseLayout title={title} description={description} locale={locale}>
  <InnerHero eyebrow="Research" title={localize(profile.visionTitle, locale)} description={description} />
  <section class="shell research-overview" aria-label={locale === 'zh' ? '研究愿景' : 'Research vision'}>
    <p>{localize(profile.vision, locale)}</p>
    <ResearchVision locale={locale} />
  </section>
  <section class="section research-featured shell" aria-labelledby="research-publications-title">
    <div class="section-heading">
      <p class="eyebrow">Publications</p>
      <h2 id="research-publications-title">{locale === 'zh' ? '代表论文' : 'Selected publications'}</h2>
    </div>
    <div class="publication-list">
      {publications.filter((item) => item.featured).map((publication) => <PublicationRow publication={publication} locale={locale} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .research-overview { padding-block: 42px 0; }
  .research-overview > p { max-width: 860px; margin: 0 0 24px; color: var(--ink-soft); font-size: 18px; line-height: 1.9; }
  .research-featured { padding-top: 66px; }
  @media (max-width: 600px) {
    .research-overview { padding-top: 30px; }
    .research-overview > p { font-size: 16px; }
    .research-featured { padding-top: 46px; }
  }
</style>

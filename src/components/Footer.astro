---
import { ArrowUpRight, Mail } from '@lucide/astro';
import type { Locale } from '../data/profile';
import { links, sources } from '../data/profile';
import { t } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = t(locale);
const updatedAt = new Date();
const updatedIso = updatedAt.toISOString();
const updatedLabel = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric', month: '2-digit', day: '2-digit',
}).format(updatedAt);
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-signoff">
      <p class="eyebrow">{locale === 'zh' ? '联系' : 'Contact'}</p>
      <h2>{copy.contactTitle}</h2>
      <p>{copy.contactBody}</p>
      <a class="text-link" href={links.email}>
        <Mail size={17} stroke-width={1.8} aria-hidden="true" />
        cw501907@gmail.com
      </a>
    </div>
    <div class="footer-meta">
      <div class="footer-links">
        {sources.map((source) => (
          <a href={source.url} target="_blank" rel="noreferrer">
            {source.label}<ArrowUpRight size={13} aria-hidden="true" />
          </a>
        ))}
      </div>
      <div class="site-stats" aria-label={locale === 'zh' ? '网站信息' : 'Site information'}>
        <span>{copy.siteUpdated} <time datetime={updatedIso}>{updatedLabel}</time></span>
        <span class="traffic-count">{copy.siteViews} <strong id="vercount_value_site_pv">—</strong></span>
        <span class="traffic-count">{copy.siteVisitors} <strong id="vercount_value_site_uv">—</strong></span>
        <span class="traffic-local">{locale === 'zh' ? '本地预览不计数' : 'Local previews are not counted'}</span>
      </div>
      <p>© {new Date().getFullYear()} Wang Chen · Xiamen, China</p>
    </div>
  </div>
</footer>

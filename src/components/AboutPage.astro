---
import { ArrowUpRight, Mail } from '@lucide/astro';
import type { Locale } from '../data/profile';
import { experience, links, profile, sources } from '../data/profile';
import { localize } from '../lib/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutIntro from './AboutIntro.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const title = locale === 'zh' ? '关于 | 陈旺' : 'About | Wang Chen';
const description = localize(profile.intro, locale);
const journey = [...experience].sort((a, b) => b.startDate.localeCompare(a.startDate));
---
<BaseLayout title={title} description={description} locale={locale}>
  <section class="about-page-intro shell" aria-labelledby="about-page-title">
    <figure class="about-page-photo"><img src="/images/wang-chen-outdoors.jpg" alt={locale === 'zh' ? '陈旺在山湖边的个人照片' : 'Wang Chen by a mountain lake'} width="1200" height="1600" /></figure>
    <div class="about-page-copy">
      <p class="eyebrow">About</p>
      <h1 id="about-page-title">{locale === 'zh' ? '关于我' : 'About me'}</h1>
      <AboutIntro locale={locale} />
      <div class="about-links">
        <a href={links.email}><Mail size={16} aria-hidden="true" />cw501907@gmail.com</a>
      </div>
    </div>
  </section>
  <section class="section shell about-details">
    <div>
      <p class="eyebrow">Timeline</p>
      <h2>{locale === 'zh' ? '学习与经历' : 'Education and experience'}</h2>
    </div>
    <div class="about-timeline">
      {journey.map((item) => (
        <article><time>{localize(item.period, locale)}</time><h3>{localize(item.title, locale)}</h3>{localize(item.detail, locale) && <p>{localize(item.detail, locale)}</p>}</article>
      ))}
    </div>
  </section>
  <section class="about-records">
    <div class="shell about-details">
      <div><p class="eyebrow">Records</p><h2>{locale === 'zh' ? '公开学术档案' : 'Public academic records'}</h2></div>
      <div class="record-links">
        {sources.map((source) => <a href={source.url} target="_blank" rel="noreferrer"><span>{source.label}</span><ArrowUpRight size={17} aria-hidden="true" /></a>)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page-intro { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 66px; padding-block: 64px 58px; border-bottom: 1px solid var(--line); }
  .about-page-photo { align-self: start; margin: 0; }
  .about-page-photo img { width: 100%; aspect-ratio: 3 / 4; height: auto; border-radius: 5px; object-fit: cover; }
  .about-page-copy { min-width: 0; }
  .about-page-copy h1 { margin-bottom: 26px; font-size: 44px; }
  @media (max-width: 900px) {
    .about-page-intro { grid-template-columns: 1fr; gap: 30px; padding-block: 40px 44px; }
    .about-page-photo { width: 180px; }
    .about-page-copy h1 { font-size: 38px; }
  }
</style>

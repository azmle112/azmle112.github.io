---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../data/profile';
import { formatDate, localePath, t } from '../lib/i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: Locale;
}

const { post, locale } = Astro.props;
const copy = t(locale);
const slug = post.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') ?? post.id;
const href = localePath(locale, `/blog/${slug}/`);
---

<article class="post-list-entry">
  <h2 class="post-list-title"><a href={href}>{post.data.title}</a></h2>
  <p class="post-list-summary">{post.data.description}</p>
  <div class="post-list-meta">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time>
    <span aria-hidden="true">·</span>
    <span>{post.data.readingTime}{locale === 'en' ? ` ${copy.minRead}` : ''}</span>
    {post.data.updatedDate && <>
      <span aria-hidden="true">·</span>
      <span>{copy.latestUpdate} <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate, locale)}</time></span>
    </>}
  </div>
</article>

<style>
  .post-list-entry {
    min-width: 0;
    padding-block: 28px;
    border-bottom: 1px solid var(--line);
  }

  .post-list-title {
    margin: 0 0 10px;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 25px;
    font-weight: 600;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .post-list-title a {
    text-decoration: none;
    transition: color 160ms ease;
  }

  .post-list-title a:hover {
    color: var(--pine);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .post-list-summary {
    margin: 0 0 13px;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.75;
  }

  .post-list-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 3px 9px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .post-list-entry {
      padding-block: 24px;
    }

    .post-list-title {
      font-size: 23px;
    }
  }
</style>

---
import { ArrowRight, ArrowUpRight, GraduationCap, Mail, MapPin, MessageCircle } from '@lucide/astro';
import { getCollection } from 'astro:content';
import type { Locale } from '../data/profile';
import { experience, links, news, profile, publications } from '../data/profile';
import { localePath, localize, t } from '../lib/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationRow from './PublicationRow.astro';
import AboutIntro from './AboutIntro.astro';
import '../styles/home.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = t(locale);
const zh = locale === 'zh';
const allPosts = await getCollection('blog', ({ data }) => data.lang === locale && !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);
const pageTitle = 'Wang Chen (陈旺) - Homepage';
const selected = publications.filter((publication) => publication.featured);
const journey = [...experience].sort((a, b) => b.startDate.localeCompare(a.startDate));
---

<BaseLayout title={pageTitle} description={localize(profile.intro, locale)} locale={locale}>
  <div class="academic-home shell">
    <aside class="profile-rail" aria-label={zh ? '个人资料' : 'Profile'}>
      <div class="profile-sticky">
        <img class="profile-photo" src="/images/wang-chen-outdoors.jpg" alt={zh ? '陈旺在山湖边的个人照片' : 'Wang Chen by a mountain lake'} width="1200" height="1600" fetchpriority="high" />
        <div class="profile-identity">
          <h1>{localize(profile.name, locale)}<span>{zh ? profile.nameLatin : '陈旺'}</span></h1>
          <p class="profile-role">{zh ? '博士生在读' : 'PhD student'}</p>
          <p class="profile-affiliation">{zh ? '厦门大学' : 'Xiamen University'}<br /><a href={links.lab} target="_blank" rel="noreferrer">MAC Lab <ArrowUpRight size={12} aria-hidden="true" /></a></p>
          <p class="profile-location"><MapPin size={14} aria-hidden="true" />{zh ? '中国 · 厦门' : 'Xiamen, China'}</p>
        </div>
        <div class="profile-resources">
          <a href={links.email}><Mail size={15} aria-hidden="true" /><span>cw501907@gmail.com</span></a>
          <a href={links.scholar} target="_blank" rel="noreferrer"><GraduationCap size={16} aria-hidden="true" /><span>Google Scholar</span><ArrowUpRight size={12} aria-hidden="true" /></a>
          <a href={links.orcid} target="_blank" rel="noreferrer"><span class="orcid-symbol" aria-hidden="true">iD</span><span>ORCID</span><ArrowUpRight size={12} aria-hidden="true" /></a>
          <a href={links.wechat} target="_blank" rel="noreferrer"><MessageCircle size={15} aria-hidden="true" /><span>{zh ? '公众号 · AI骇客' : 'WeChat · AI Hacker'}</span><ArrowUpRight size={12} aria-hidden="true" /></a>
        </div>
      </div>
    </aside>

    <div class="academic-content">
      <section id="about" class="home-about" aria-labelledby="about-heading" data-home-section>
        <div class="academic-section-heading"><h2 id="about-heading">{zh ? '关于我' : 'About me'}{zh && <span>About me</span>}</h2><span class="section-number" aria-hidden="true">01</span></div>
        <AboutIntro locale={locale} />
      </section>

      <section id="news" class="home-section home-news" aria-labelledby="news-heading" data-home-section>
        <div class="academic-section-heading"><h2 id="news-heading">{zh ? '近况' : 'News'}<span>{zh ? 'News' : ''}</span></h2><span class="section-number" aria-hidden="true">02</span></div>
        <ol class="update-list">
          {news.map((item, index) => <li><time datetime={item.date.replace('.', '-')}>{item.date}</time><p>{index === 0 && <span class="news-dot" aria-label={zh ? '最新' : 'Latest'}></span>}{localize(item.text, locale)}</p></li>)}
        </ol>
      </section>

      <section id="publications" class="home-section home-publications" aria-labelledby="publications-heading" data-home-section>
        <div class="academic-section-heading"><h2 id="publications-heading">{zh ? '代表论文' : 'Selected publications'}<span>{zh ? 'Selected publications' : ''}</span></h2><span class="section-number" aria-hidden="true">03</span></div>
        <div class="publication-subhead"><p>{zh ? '* 表示共同贡献' : '* Equal contribution'}</p><a class="quiet-link" href={localePath(locale, '/publications/')}>{zh ? `全部 ${publications.length} 篇论文` : `All ${publications.length} publications`}<ArrowUpRight size={14} aria-hidden="true" /></a></div>
        <div class="publication-list">{selected.map((publication) => <PublicationRow publication={publication} locale={locale} compact />)}</div>
      </section>

      <section id="experience" class="home-section" aria-labelledby="experience-heading" data-home-section>
        <div class="academic-section-heading"><h2 id="experience-heading">{zh ? '教育与经历' : 'Education & experience'}<span>{zh ? 'Experience' : ''}</span></h2><span class="section-number" aria-hidden="true">04</span></div>
        <div class="journey-list">
          {journey.map((item) => <article class:list={['journey-entry', { 'is-internship': item.kind === 'internship' }]}>
            <div class="institution-mark"><img src={item.logo} alt={zh ? `${localize(item.organization, locale)}标识` : `${localize(item.organization, locale)} logo`} width="52" height="52" loading="lazy" /></div>
            <div class="journey-copy"><h3>{localize(item.organization, locale)}<span>{localize(item.role, locale)}</span></h3>{localize(item.detail, locale) && <p>{localize(item.detail, locale)}</p>}</div>
            <div class="journey-meta"><span class="journey-kind">{item.kind === 'internship' ? (zh ? '实习' : 'Internship') : (zh ? '教育' : 'Education')}</span><p>{localize(item.period, locale)}</p></div>
          </article>)}
        </div>
      </section>

      <section id="writing" class="home-section home-writing" aria-labelledby="writing-heading" data-home-section>
        <div class="academic-section-heading"><h2 id="writing-heading">Blog</h2><span class="section-number" aria-hidden="true">05</span></div>
        <div class="notes-list">
          {posts.map((post) => {
            const slug = post.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') ?? post.id;
            return <article><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10).replaceAll('-', '.')}</time><div><h3><a href={localePath(locale, `/blog/${slug}/`)}>{post.data.title}<ArrowUpRight size={15} aria-hidden="true" /></a></h3><p>{post.data.description}</p><span class="note-reading-time">{post.data.readingTime}{zh ? '' : ' read'}</span></div></article>;
          })}
        </div>
        <a class="quiet-link" href={localePath(locale, '/blog/')}>{copy.allNotes}<ArrowRight size={15} aria-hidden="true" /></a>
      </section>
    </div>
  </div>
</BaseLayout>

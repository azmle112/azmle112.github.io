---
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import type { Locale } from '../data/profile';
import { formatDate, localePath, t } from '../lib/i18n';
import BaseLayout from './BaseLayout.astro';
import 'katex/dist/katex.min.css';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  locale: Locale;
}

const { post, headings, locale } = Astro.props;
const copy = t(locale);
const toc = headings.filter((heading) => post.data.tocDepth === 'chapters' ? heading.depth === 2 : heading.depth === 2 || heading.depth === 3);
const translationPost = (await getCollection('blog', ({ data }) => data.translationKey === post.data.translationKey && data.lang !== locale && !data.draft))[0];
const translationSlug = translationPost?.id.split('/').pop()?.replace(/\.(md|mdx)$/, '');
const translationHref = translationSlug ? localePath(locale === 'zh' ? 'en' : 'zh', `/blog/${translationSlug}/`) : undefined;
const languageSwitchHref = translationHref ?? localePath(locale === 'zh' ? 'en' : 'zh', '/blog/');
const articleUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const coverUrl = Astro.site ? new URL('/og.png', Astro.site) : new URL('/og.png', Astro.url);
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: locale === 'zh' ? 'zh-CN' : 'en-US',
  author: { '@type': 'Person', name: locale === 'zh' ? '陈旺' : 'Wang Chen' },
  mainEntityOfPage: articleUrl.toString(),
  image: coverUrl.toString(),
  keywords: post.data.tags,
}).replace(/</g, '\\u003c');
---
<BaseLayout title={`${post.data.title} | ${locale === 'zh' ? '陈旺' : 'Wang Chen'}`} description={post.data.description} locale={locale} article publishedTime={post.data.pubDate} modifiedTime={post.data.updatedDate ?? post.data.pubDate} alternateHref={translationHref ?? null} languageSwitchHref={languageSwitchHref}>
  <script is:inline type="application/ld+json" set:html={structuredData}></script>
  <article class="article-page">
    <div class="reading-progress" aria-hidden="true"><i data-reading-progress></i></div>
    <header class="post-heading">
      <a class="post-heading-back" href={localePath(locale, '/blog/')}><ArrowLeft size={15} />{locale === 'zh' ? '返回 Blog' : 'Back to Blog'}</a>
      <h1 class="post-heading-title">{post.data.title}</h1>
      <p class="post-heading-description">{post.data.description}</p>
      <div class="post-heading-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time>
        <span>{post.data.readingTime}{locale === 'en' ? ` ${copy.minRead}` : ''}</span>
        {post.data.updatedDate && <span>{copy.latestUpdate} <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate, locale)}</time></span>}
        {translationHref && <a href={translationHref}>{locale === 'zh' ? 'Read in English' : '阅读中文版'}<ArrowUpRight size={13} /></a>}
      </div>
    </header>

    <div class:list={['article-shell shell post-reading-layout', { 'without-toc': toc.length === 0 }]}>
      {toc.length > 0 && (
        <aside class="article-toc" aria-label={locale === 'zh' ? '文章目录' : 'Table of contents'}>
          <details open data-article-toc>
            <summary>{locale === 'zh' ? '文章目录' : 'On this page'}</summary>
            <nav>
              {toc.map((heading) => (
                <a class:list={[`toc-depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>
              ))}
            </nav>
          </details>
        </aside>
      )}
      <div class="article-main">
        <div class="prose"><slot /></div>
        {post.data.sources.length > 0 && (
          <section class="article-sources" aria-labelledby="sources-title">
            <h2 id="sources-title">{locale === 'zh' ? '主要来源' : 'Primary sources'}</h2>
            <ol>
              {post.data.sources.map((source) => (
                <li><a href={source.url} target="_blank" rel="noreferrer">{source.label}<ArrowUpRight size={13} /></a></li>
              ))}
            </ol>
          </section>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-heading {
    width: min(980px, calc(100% - 64px));
    margin-inline: auto;
    padding-block: 46px 30px;
    border-bottom: 1px solid var(--line);
  }

  .post-heading-back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 25px;
    color: var(--pine-dark);
    font-size: 14px;
    text-decoration: none;
  }

  .post-heading-back:hover {
    text-decoration: underline;
  }

  .post-heading-title {
    max-width: 920px;
    margin: 0 0 17px;
    font-size: clamp(29px, 3.2vw, 38px);
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .post-heading-description {
    max-width: 850px;
    margin: 0 0 20px;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.75;
  }

  .post-heading-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 7px 20px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .post-heading-meta > span,
  .post-heading-meta > a {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
  }

  .post-heading-meta strong {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .post-heading-meta a {
    align-items: center;
    color: var(--pine-dark);
    text-decoration: none;
  }

  .post-heading-meta a:hover {
    text-decoration: underline;
  }

  .post-reading-layout {
    padding-top: 38px;
  }

  @media (max-width: 600px) {
    .post-heading {
      width: calc(100% - 36px);
      padding-block: 30px 25px;
    }

    .post-heading-back {
      margin-bottom: 21px;
    }

    .post-heading-title {
      font-size: 28px;
    }

    .post-reading-layout {
      padding-top: 28px;
    }
  }
</style>

<script>
  const toc = document.querySelector<HTMLDetailsElement>('[data-article-toc]');
  if (toc && window.matchMedia('(max-width: 760px)').matches) toc.open = false;

  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  const updateProgress = () => {
    if (!progress) return;
    const article = document.querySelector<HTMLElement>('.article-page');
    if (!article) return;
    const start = article.offsetTop;
    const distance = Math.max(article.offsetHeight - window.innerHeight, 1);
    const value = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
    progress.style.transform = `scaleX(${value})`;
  };
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.article-toc a')];
  const headings = tocLinks
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((heading): heading is HTMLElement => Boolean(heading));

  if ('IntersectionObserver' in window && headings.length) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).at(-1);
      if (!visible) return;
      tocLinks.forEach((link) => link.classList.toggle('active', link.hash === `#${visible.target.id}`));
    }, { rootMargin: '-18% 0px -68% 0px' });
    headings.forEach((heading) => observer.observe(heading));
  }
</script>

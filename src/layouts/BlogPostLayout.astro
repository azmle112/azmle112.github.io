---
import { ArrowLeft, ArrowUpRight, CalendarDays, Clock3 } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import type { Locale } from '../data/profile';
import { formatDate, localePath, t } from '../lib/i18n';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  locale: Locale;
}

const { post, headings, locale } = Astro.props;
const copy = t(locale);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const slug = post.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') ?? post.id;
const translationHref = localePath(locale === 'zh' ? 'en' : 'zh', `/blog/${slug}/`);
---
<BaseLayout title={`${post.data.title} | ${locale === 'zh' ? '陈旺' : 'Wang Chen'}`} description={post.data.description} locale={locale} article>
  <article class="article-page">
    <header class="article-header shell">
      <a class="back-link" href={localePath(locale, '/blog/')}><ArrowLeft size={15} />{locale === 'zh' ? '返回文章' : 'Back to notes'}</a>
      <div class="article-kicker"><span>{post.data.tags[0]}</span><span>Research Notes</span></div>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-byline">
        <span><CalendarDays size={15} />{formatDate(post.data.pubDate, locale)}</span>
        <span><Clock3 size={15} />{post.data.readingTime}{locale === 'en' ? ` ${copy.minRead}` : ''}</span>
        {post.data.updatedDate && <span>{copy.latestUpdate} {formatDate(post.data.updatedDate, locale)}</span>}
        <a href={translationHref}>{locale === 'zh' ? 'Read in English' : '阅读中文版'}<ArrowUpRight size={13} /></a>
      </div>
    </header>

    <div class="article-shell shell">
      {toc.length > 0 && (
        <aside class="article-toc" aria-label={locale === 'zh' ? '文章目录' : 'Table of contents'}>
          <details open data-article-toc>
            <summary>{locale === 'zh' ? '文章目录' : 'On this page'}</summary>
            <nav>
              {toc.map((heading) => (
                <a class:list={[`toc-depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>
              ))}
            </nav>
          </details>
        </aside>
      )}
      <div class="article-main">
        <div class="prose"><slot /></div>
        {post.data.sources.length > 0 && (
          <section class="article-sources" aria-labelledby="sources-title">
            <h2 id="sources-title">{locale === 'zh' ? '主要来源' : 'Primary sources'}</h2>
            <ol>
              {post.data.sources.map((source) => (
                <li><a href={source.url} target="_blank" rel="noreferrer">{source.label}<ArrowUpRight size={13} /></a></li>
              ))}
            </ol>
          </section>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const toc = document.querySelector<HTMLDetailsElement>('[data-article-toc]');
  if (toc && window.matchMedia('(max-width: 760px)').matches) toc.open = false;
</script>

---
import '@fontsource-variable/noto-sans-sc';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeController from '../components/ThemeController.astro';
import type { Locale } from '../data/profile';
import { alternatePath } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  image?: string | null;
  article?: boolean;
  noFooter?: boolean;
  alternateHref?: string | null;
  languageSwitchHref?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const { title, description, locale, image = '/og.png', article = false, noFooter = false, alternateHref, languageSwitchHref, publishedTime, modifiedTime } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = Astro.site ? new URL(pathname, Astro.site) : Astro.url;
const alternatePathname = alternateHref === undefined ? alternatePath(locale, pathname) : alternateHref;
const alternate = alternatePathname ? (Astro.site ? new URL(alternatePathname, Astro.site) : new URL(alternatePathname, Astro.url)) : undefined;
const fullImage = image ? (Astro.site ? new URL(image, Astro.site) : new URL(image, Astro.url)) : undefined;
---

<!doctype html>
<html data-palette="blue" lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <ThemeController />
    <link rel="canonical" href={canonical} />
    {alternate && <link rel="alternate" hreflang={locale === 'zh' ? 'en' : 'zh-CN'} href={alternate} />}
    <link rel="alternate" hreflang="x-default" href={locale === 'zh' || !alternate ? canonical : alternate} />
    <link rel="icon" href="/favicon.jpg" type="image/jpeg" />
    <title>{title}</title>
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {fullImage && <meta property="og:image" content={fullImage} />}
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    {article && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {article && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content={fullImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <Header locale={locale} pathname={pathname} alternateHref={languageSwitchHref} />
    <main id="content">
      <slot />
    </main>
    {!noFooter && <Footer locale={locale} />}
  </body>
</html>
